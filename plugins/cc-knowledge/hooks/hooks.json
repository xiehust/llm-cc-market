{
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end-cultivate.js\"",
            "timeout": 120
          }
        ],
        "description": "Gate session for knowledge cultivation and spawn extractor"
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start-check.js\""
          }
        ],
        "description": "Check for pending cultivation markers"
      }
    ]
  }
}
